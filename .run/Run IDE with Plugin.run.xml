<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Run Plugin" type="GradleRunConfiguration" factoryName="Gradle">
    <!-- IntelliJ Platform Gradle Plugin 2.x sandbox layout: the sandbox root embeds the project
         name and the exact pinned platform build (build.gradle.kts's intellijIdea("2025.2.6.2")),
         unlike 1.x's fixed build/idea-sandbox/system/log/. There is no stable alias for this path
         (confirmed: no symlink under .intellijPlatform/sandbox/typewriter2/), so bumping the
         platform version in build.gradle.kts means updating this path too. -->
    <log_file alias="idea.log" path="$PROJECT_DIR$/.intellijPlatform/sandbox/typewriter2/IU-2025.2.6.2/log/idea.log" />
    <ExternalSystemSettings>
      <option name="executionName" />
      <option name="externalProjectPath" value="$PROJECT_DIR$" />
      <option name="externalSystemIdString" value="GRADLE" />
      <option name="scriptParameters" value="" />
      <option name="taskDescriptions">
        <list />
      </option>
      <option name="taskNames">
        <list>
          <option value="runIde" />
        </list>
      </option>
      <option name="vmOptions" value="" />
    </ExternalSystemSettings>
    <ExternalSystemDebugServerProcess>true</ExternalSystemDebugServerProcess>
    <ExternalSystemReattachDebugProcess>true</ExternalSystemReattachDebugProcess>
    <DebugAllEnabled>false</DebugAllEnabled>
    <method v="2" />
  </configuration>
</component>
